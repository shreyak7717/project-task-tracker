# Copy to .env for local dev (docker-compose sets these itself).
# Host port 5433 -> container 5432 (avoids clashing with a local Postgres on 5432).
DATABASE_URL=postgresql+psycopg2://tracker:tracker@localhost:5433/tracker
JWT_SECRET=dev-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=["http://localhost:5173"]
